{
    "extends": [
        "config:recommended"
    ],
    "schedule": "every weekend",
    "bundler": {
        "enabled": true
    },
    "ignoreDeps": [
        "jekyll"
    ],
    "labels": [
        "review:tech"
    ],
    "cloneSubmodules": true,
    "customManagers": [
        {
            "customType": "regex",
            "fileMatch": [
                "(^|/)Makefile$",
                "\\.github/reusable-steps/install-deps/action\\.yaml$"
            ],
            "matchStrings": [
                "npm install -g corepack@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
            ],
            "depNameTemplate": "corepack",
            "datasourceTemplate": "npm"
        }
    ],
    "packageRules": [
        {
            "groupName": "Non-major dependencies",
            "groupSlug": "all-minor-patch",
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "matchPackageNames": [
                "*"
            ]
        }
    ]
}