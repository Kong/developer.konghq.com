{
  "$id": "schema:support",
  "allOf": [
    {
      "$ref": "schema:base"
    }
  ],
  "properties": {
    "tldr": {
      "nullable": true,
      "type": "object",
      "properties": {
        "q": {
          "type": "string"
        },
        "a": {
          "type": "string"
        }
      },
      "required": [
        "q",
        "a"
      ]
    },
    "min_version": {
      "$ref": "schema:base#/definitions/min_version"
    },
    "advisory": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^KONGSA-\\d{8}$"
        },
        "published": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "cves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^CVE-\\d{4}-\\d{4,}$"
              },
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "high",
                  "medium",
                  "low"
                ]
              },
              "cvss_score": {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              "cvss_version": {
                "type": "string"
              },
              "summary": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "affected",
                  "not_affected"
                ]
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "affected_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixed_versions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "products": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "product": {
                "type": "string",
                "enum": [
                  "gateway",
                  "ai-gateway",
                  "mesh",
                  "kic",
                  "operator"
                ]
              },
              "affected_versions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "fixed_versions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "product"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "content_type",
    "title",
    "products"
  ],
  "if": {
    "required": [
      "advisory"
    ]
  },
  "else": {
    "required": [
      "tldr"
    ]
  }
}
