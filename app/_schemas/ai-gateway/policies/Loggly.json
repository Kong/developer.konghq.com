{
  "properties": {
    "protocols": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "grpc",
          "grpcs",
          "http",
          "https",
          "tcp",
          "tls",
          "tls_passthrough",
          "udp",
          "ws",
          "wss"
        ],
        "description": "A string representing a protocol, such as HTTP or HTTPS."
      },
      "description": "A set of strings representing protocols.",
      "default": [
        "grpc",
        "grpcs",
        "http",
        "https"
      ]
    },
    "config": {
      "type": "object",
      "properties": {
        "successful_severity": {
          "type": "string",
          "enum": [
            "alert",
            "crit",
            "debug",
            "emerg",
            "err",
            "info",
            "notice",
            "warning"
          ],
          "default": "info"
        },
        "host": {
          "type": "string",
          "description": "A string representing a host name, such as example.com.",
          "default": "logs-01.loggly.com"
        },
        "port": {
          "type": "integer",
          "maximum": 65535,
          "minimum": 0,
          "description": "An integer representing a port number between 0 and 65535, inclusive.",
          "default": 514
        },
        "key": {
          "type": "string",
          "x-referenceable": true,
          "x-encrypted": true
        },
        "client_errors_severity": {
          "type": "string",
          "enum": [
            "alert",
            "crit",
            "debug",
            "emerg",
            "err",
            "info",
            "notice",
            "warning"
          ],
          "default": "info"
        },
        "server_errors_severity": {
          "type": "string",
          "enum": [
            "alert",
            "crit",
            "debug",
            "emerg",
            "err",
            "info",
            "notice",
            "warning"
          ],
          "default": "info"
        },
        "timeout": {
          "type": "number",
          "default": 10000
        },
        "custom_fields_by_lua": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Lua code as a key-value map"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "kong"
          ]
        },
        "log_level": {
          "type": "string",
          "enum": [
            "alert",
            "crit",
            "debug",
            "emerg",
            "err",
            "info",
            "notice",
            "warning"
          ],
          "default": "info"
        }
      },
      "required": [
        "key"
      ]
    },
    "consumer": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "If set, the policy will activate only for requests where the specified has been authenticated. (Note that some policies can not be restricted to consumers this way.). Leave unset for the policy to activate regardless of the authenticated Consumer."
    },
    "route": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "If set, the policy will only activate when receiving requests via the specified route. Leave unset for the policy to activate regardless of the route being used."
    },
    "service": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "If set, the policy will only activate when receiving requests via one of the routes belonging to the specified Service. Leave unset for the policy to activate regardless of the Service being matched."
    }
  },
  "required": [
    "config"
  ]
}